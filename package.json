{
  "name": "banking",
  "version": "1.0.0",
  "description": "A multi-page bank website built with HTML, plain CSS, vanilla JavaScript and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "prepare": "husky",
    "size": "size-limit"
  },
  "author": "Serhii Lisovyk",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "size-limit": "^14.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.1.0",
    "vite": "^8.3.3",
    "vite-plugin-handlebars": "^2.0.3",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
