[
  {
    "name": "JavaScript",
    "path": "dist/assets/*.js",
    "gzip": true,
    "limit": "4 kB"
  },
  {
    "name": "CSS",
    "path": "dist/assets/*.css",
    "gzip": true,
    "limit": "8 kB"
  },
  {
    "name": "Font",
    "path": "dist/assets/*.woff2",
    "gzip": false,
    "brotli": false,
    "limit": "42 kB"
  },
  {
    "name": "Images (decor, photo)",
    "path": "dist/assets/*.{avif,webp}",
    "gzip": false,
    "brotli": false,
    "limit": "320 kB"
  }
]
